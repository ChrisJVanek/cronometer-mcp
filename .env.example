# Cronometer account (required). The same login you use on cronometer.com.
CRONOMETER_USERNAME=you@example.com
CRONOMETER_PASSWORD=
# Only if two-factor is on: the authenticator secret (base32), needs `uv sync --extra totp`.
# CRONOMETER_TOTP_SECRET=
# Optional: the time zone your diary days are counted in.
# CRONOMETER_ACCOUNT_TZ=America/New_York

# --- Remote mode (ChatGPT, claude.ai web/mobile) ---
# Password typed on the consent page when an app connects. 8+ characters.
MCP_AUTH_PASSWORD=
# Optional fixed bearer token for clients that can send headers.
# MCP_API_KEY=
# Public https origin the apps connect to.
# MCP_PUBLIC_URL=https://cronometer.example.com
# Extra hostnames to accept, comma separated (Railway's own domain is added automatically).
# MCP_ALLOWED_HOSTS=
